CLAUDE_DIR=~/.claude
PORT=8780
HOST=127.0.0.1
WS_PATH=/ws
MOCK_EVENTS=false
STALE_IDLE_MS=300000
STALE_EVICT_MS=900000

# Multi-instance: identify this machine in the office
MACHINE_ID=
MACHINE_NAME=

# Access token: browser sign-in, WebSocket, stats, diagnostics and hooks.
# Browsers use a server-managed cookie; senders use Authorization: Bearer.
JOBS_TOKEN=
# Set true behind an HTTPS reverse proxy. Keep false for plain HTTP localhost.
COOKIE_SECURE=false
# Docker publishes loopback by default. Set explicitly for LAN access.
JOBS_BIND_ADDRESS=127.0.0.1

# Optional separate credential for /api/webhooks; otherwise JOBS_TOKEN applies.
WEBHOOK_TOKEN=

# WebSocket connection limits
WS_MAX_CLIENTS=50
WS_MAX_PER_IP=10

# Hook scripts: where to send hook/webhook events (used by remote machines)
JOBS_URL=http://localhost:8780
